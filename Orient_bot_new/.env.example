BOT_TOKEN=123456789:AAExampleToken
ADMIN_IDS=123456789
WEBAPP_URL=https://your-domain.com
# Локально: SQLite-файл рядом с проектом (путь считается от папки проекта, а не от текущей директории).
# На хостинге (Render и т.п.) ОБЯЗАТЕЛЬНО PostgreSQL: postgresql://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./orders.db
# На хостинге — путь на постоянном диске, например /var/data/uploads
UPLOAD_DIR=uploads
MAX_PHOTOS=10
MAX_FILE_SIZE=10485760
INIT_DATA_TTL=86400
